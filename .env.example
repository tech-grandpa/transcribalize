# Optional transcript analysis. File and live transcription work without these.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-opus-4.8

# Default file-transcription backend.
# Supported: whisper, parakeet-tdt-0.6b-v3, granite-2b, granite-2b-plus.
ASR_BACKEND=whisper

# Optional ASR tuning. Parakeet and Granite dependencies are included by the
# supplied Docker Compose build; local Python installs need requirements-granite.txt.
GRANITE_MAX_NEW_TOKENS=2000
GRANITE_TORCH_DTYPE=bfloat16
PARAKEET_TORCH_DTYPE=bfloat16
PARAKEET_CHUNK_SECONDS=60
PARAKEET_CHUNK_OVERLAP_SECONDS=0

# Maximum simultaneous live-transcription WebSocket sessions.
MAX_CONCURRENT_SESSIONS=4
