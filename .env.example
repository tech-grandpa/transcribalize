# Copy this file to .env and fill in your actual API key and endpoint
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-opus-4.8

# File transcription backend. Supported: whisper, granite-2b, granite-2b-plus.
# Granite backends are experimental and require transcriber/requirements-granite.txt.
ASR_BACKEND=whisper
GRANITE_MAX_NEW_TOKENS=2000
GRANITE_TORCH_DTYPE=bfloat16
